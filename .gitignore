# scripts/radios/fetch_chirp_tdh9_module.py and NOTICE.md.
.chirp-modules/
.venv-chirp/
.venv-cad/

# Radio images and backups read off a user's own hardware.
*.img
*.d75
!radio-configs/thd75-current.d75
radio-backups/

# Third-party USB serial drivers fetched for programming cables.
.drivers/

# Scratch files from interactive debugging sessions.
.tmp-*

# Editor/manual backups of CAD sources; the .scad file is the original.
*.scad.bak
